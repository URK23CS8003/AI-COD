]

prompts = [
    "Write a Python bubble sort function.",
    "Write a Python insertion sort function.",
    "Write a Python selection sort function.",
    "Write a Python linear search function.",
    "Write a Python binary search function.",
    "Write a Python factorial function.",
    "Write a Python fibonacci function.",
    "Write a Python palindrome checking function."
]

generated_codes = []

print("Generating Python code using CodeLlama...")

for prompt in prompts:
    result = ollama.generate(
        model=MODEL,
        prompt=prompt,
        options={"temperature": 0.7}
    )

    code = result.response.strip()
    code = re.sub(r"^```(?:python)?\s*|\s*```$", "", code,
                  flags=re.IGNORECASE)
    generated_codes.append(code)

    print("Generated:", prompt)

X = real_codes + generated_codes
y = [1] * len(real_codes) + [0] * len(generated_codes)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

vectorizer = TfidfVectorizer(analyzer="char", ngram_range=(2, 5))
X_train = vectorizer.fit_transform(X_train)
X_test = vectorizer.transform(X_test)

discriminator = LogisticRegression(max_iter=1000)
discriminator.fit(X_train, y_train)

predictions = discriminator.predict(X_test)

accuracy = accuracy_score(y_test, predictions)

print("\nDiscriminator Training Completed")
print("Accuracy:", round(accuracy * 100, 2), "%")

print("\nEvaluation Results:")

for code, actual, predicted in zip(X_test.toarray(), y_test, predictions):
    label = "Real" if predicted == 1 else "Generated"
    print("Actual:", actual, "| Prediction:", predicted, label)

print("\nSample Predictions:")

samples = [real_codes[0], generated_codes[0]]
sample_names = ["REAL", "GENERATED"]

for name, code in zip(sample_names, samples):
    features = vectorizer.transform([code])
    prediction = discriminator.predict(features)[0]
    confidence = max(discriminator.predict_proba(features)[0])

    print("\n[" + name + "]")
    print(code[:200])
    print("Prediction:", prediction)
    print("Confidence:", round(confidence, 2))
