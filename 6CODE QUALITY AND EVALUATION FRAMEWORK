
import ast
import subprocess
import sys

code = """
def add_numbers(a: int, b: int) -> int:
    \"\"\"Add two numbers.\"\"\"
    return a + b
"""

tests = [
    ((2, 3), 5),
    ((10, 20), 30),
    ((-2, 2), 0),
    ((0, 0), 0)
]

print("AI CODE QUALITY EVALUATION")

# 1. Syntax checking
try:
    ast.parse(code)
    print("\nSyntax Check: PASS")
except SyntaxError:
    print("\nSyntax Check: FAIL")
    sys.exit()

# Save generated code
with open("generated_code.py", "w") as f:
    f.write(code)

# 2. Pylint analysis
print("\nPYLINT ANALYSIS")
p = subprocess.run(
    [sys.executable, "-m", "pylint", "generated_code.py"],
    capture_output=True, text=True
)
print(p.stdout + p.stderr)

# 3. Mypy analysis
print("\nMYPY TYPE CHECKING")
m = subprocess.run(
    [sys.executable, "-m", "mypy", "generated_code.py"],
    capture_output=True, text=True
)
print(m.stdout + m.stderr)

# 4. Dynamic testing
namespace = {}
exec(code, namespace)

passed = 0

for args, expected in tests:
    result = namespace["add_numbers"](*args)
    if result == expected:
        passed += 1
        print("PASS:", args)
    else:
        print("FAIL:", args)

# 5. Statistical analysis
total = len(tests)
failed = total - passed
percentage = (passed / total) * 100

print("\nSTATISTICAL ANALYSIS")
print("Total Tests:", total)
print("Passed:", passed)
print("Failed:", failed)
print("Success Percentage:", percentage, "%")
