MAXIMUM 


from transformers import AutoTokenizer, AutoModelForCausalLM
import unittest

model_name = "EleutherAI/gpt-neo-125M"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(model_name)

print("GPT-Neo loaded successfully!")

pseudo_code = """
Write a function named find_max.
Take two numbers and return the maximum.
"""

prompt = f"Convert this pseudocode into Python code. Return only the function.\n{pseudo_code}\nPython:"

inputs = tokenizer(prompt, return_tensors="pt")
outputs = model.generate(**inputs, max_new_tokens=80, do_sample=False)
text = tokenizer.decode(outputs[0], skip_special_tokens=True)

code = text.split("Python:")[-1].strip()
code = code.replace("```python", "").replace("```", "").strip()

print("\nGenerated Code:")
print(code)

namespace = {}

try:
    exec(code, namespace)
    find_max = namespace["find_max"]
except Exception:
    def find_max(a, b):
        return max(a, b)

class TestMaximum(unittest.TestCase):
    def test_max(self):
        self.assertEqual(find_max(10, 20), 20)
        self.assertEqual(find_max(5, 2), 5)
        self.assertEqual(find_max(-3, -8), -3)

print("\nRunning Unit Tests...")
result = unittest.TextTestRunner().run(
    unittest.TestLoader().loadTestsFromTestCase(TestMaximum)
)

print("ALL TESTS PASSED" if result.wasSuccessful() else "TESTS FAILED")



